#!/bin/sh
set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

DEV_ROOT=/ordax/dev-base
DEV_INIT=/sbin/ordax-dev-init
DEV_INIT_SOURCE=$DEV_ROOT$DEV_INIT

fail() {
    echo "ordax-dev-bootstrap: $*" >&2
    echo "ordax-dev-bootstrap: entering local recovery shell" >&2
    exec sh
}

# This script still runs under the fixed initramfs BusyBox. Keep validation
# limited to applets explicitly built into that capsule; do not depend on
# `test`, `[`, or the optional ash `command` builtin.
cd "$DEV_ROOT" 2>/dev/null || fail "development base is missing"
cd /
cat "$DEV_INIT_SOURCE" >/dev/null 2>&1 || fail "development init is missing or unreadable: $DEV_INIT_SOURCE"

for directory in proc sys dev run; do
    mkdir -p "$DEV_ROOT/$directory"
done

mount -o bind "$DEV_ROOT" "$DEV_ROOT" || fail "cannot bind development root"
mount -o bind /proc "$DEV_ROOT/proc" || fail "cannot bind /proc"
mount -o bind /sys "$DEV_ROOT/sys" || fail "cannot bind /sys"
mount -o bind /dev "$DEV_ROOT/dev" || fail "cannot bind /dev"

echo "ordax-dev-bootstrap: minimal base ready; handing off to network + Git" >&2
exec switch_root "$DEV_ROOT" "$DEV_INIT"

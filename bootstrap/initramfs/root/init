#!/bin/sh
set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

BOOTSTRAP_PATH=/ordax/bootstrap/entrypoint
RECOVERY_BOOTSTRAP_PATH=/ordax/bootstrap/recovery/entrypoint

rescue() {
    echo "ordax-initramfs: entering local recovery shell: $*" >&2
    exec sh
}

mkdir -p /proc /sys /dev /run /ordax
mount -t proc proc /proc || rescue "cannot mount /proc"
mount -t sysfs sysfs /sys || rescue "cannot mount /sys"
mount -t devtmpfs devtmpfs /dev || rescue "cannot mount /dev"

RECOVERY_MODE=0
case " $(cat /proc/cmdline 2>/dev/null || true) " in
    *" ordax.mode=recovery "*) RECOVERY_MODE=1 ;;
esac

ORDAX_DEVICE="$(findfs LABEL=ORDAX 2>/dev/null || true)"
case "$ORDAX_DEVICE" in
    "") rescue "ORDAX partition not found" ;;
esac

case "$RECOVERY_MODE" in
    1)
        mount -t ext4 -o ro "$ORDAX_DEVICE" /ordax || rescue "cannot mount ORDAX read-only"
        cat "$RECOVERY_BOOTSTRAP_PATH" >/dev/null 2>&1 || rescue "recovery entrypoint is missing or unreadable: $RECOVERY_BOOTSTRAP_PATH"
        exec "$RECOVERY_BOOTSTRAP_PATH"
        ;;
esac

mount -t ext4 -o rw "$ORDAX_DEVICE" /ordax || rescue "cannot mount ORDAX"
if ! /sbin/ordax-grow-ext4 "$ORDAX_DEVICE" /ordax; then
    echo "ordax-initramfs: warning: ORDAX filesystem could not grow to partition capacity; continuing with current verified filesystem" >&2
fi

cat "$BOOTSTRAP_PATH" >/dev/null 2>&1 || rescue "bootstrap entrypoint is missing or unreadable: $BOOTSTRAP_PATH"
exec "$BOOTSTRAP_PATH"

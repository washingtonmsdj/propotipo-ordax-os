#!/bin/sh
set -eu

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/root
export PATH HOME

WORKTREE=${ORDAX_WORKTREE:-/workspace/ordax}
WORKSPACE_DIR=${ORDAX_WORKSPACE_DIR:-$(dirname "$WORKTREE")}
STATE_DIR=${ORDAX_STATE_DIR:-/state/ordax}
NETWORK_STATE_DIR=${ORDAX_NETWORK_STATE_DIR:-/state/network}
BIN_DIR=${ORDAX_BIN_DIR:-/usr/local/bin}
PINNED_FILE=$STATE_DIR/pinned-commit
BOOT_REJECTED_FILE=$STATE_DIR/boot-rejected-commit
BOOT_METRICS_FILE=$STATE_DIR/boot-last.tsv
BOOT_NETWORK_LOG=$STATE_DIR/boot-network.log
BOOT_STARTED_EPOCH=$(/bin/busybox date +%s 2>/dev/null || printf '0')
BOOT_PULL_ATTEMPTS=${ORDAX_BOOT_PULL_ATTEMPTS:-2}
ROOTFS_SELECTION_DIR=$STATE_DIR/base-update/rootfs
ROOTFS_VERSIONS_ROOT=${ORDAX_DEV_VERSION_ROOT:-/versions}
ROOTFS_SELECTED=${ORDAX_DEV_ROOT_SELECTED:-0}
ROOTFS_SELECTED_COMMIT=${ORDAX_DEV_ROOT_COMMIT:-seed}

case "$BOOT_PULL_ATTEMPTS" in
    ''|*[!0-9]*) BOOT_PULL_ATTEMPTS=2 ;;
esac
[ "$BOOT_PULL_ATTEMPTS" -ge 1 ] 2>/dev/null || BOOT_PULL_ATTEMPTS=2
[ "$BOOT_PULL_ATTEMPTS" -le 3 ] 2>/dev/null || BOOT_PULL_ATTEMPTS=3

is_commit_sha() {
    value=$1
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        *[!0-9a-f]*|'') return 1 ;;
    esac
    return 0
}

write_state() {
    destination=$1
    value=$2
    temporary=$destination.tmp.$
    printf '%s\n' "$value" >"$temporary"
    mv -f "$temporary" "$destination"
}

local_checkout_bootable() {
    [ -d "$WORKTREE/.git" ] || return 1
    [ -x "$WORKTREE/system/entrypoint" ] || return 1
    local_sha=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    is_commit_sha "$local_sha" || return 1
    local_status=$(git -C "$WORKTREE" status --porcelain 2>/dev/null) || return 1
    [ -z "$local_status" ]
}

record_boot_handoff() {
    mode=$1
    source_sha=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || printf 'unknown')
    ended=$(/bin/busybox date +%s 2>/dev/null || printf '0')
    elapsed=0
    case "$BOOT_STARTED_EPOCH:$ended" in
        *[!0-9:]*|'0:'*|*:0) elapsed=0 ;;
        *)
            if [ "$ended" -ge "$BOOT_STARTED_EPOCH" ] 2>/dev/null; then
                elapsed=$((ended - BOOT_STARTED_EPOCH))
            fi
            ;;
    esac
    temporary=$BOOT_METRICS_FILE.tmp.$
    printf '%s\t%s\t%s\t%s\n' "$mode" "$elapsed" "$source_sha" "$ended" >"$temporary"
    mv -f "$temporary" "$BOOT_METRICS_FILE"
}

start_network_background() {
    # A healthy local release must never wait for Wi-Fi, DHCP, NTP or Git.
    # The supervisor will retry remote checks after connectivity appears.
    (
        "$BIN_DIR/ordax-network" >"$BOOT_NETWORK_LOG.tmp" 2>&1 || true
        mv -f "$BOOT_NETWORK_LOG.tmp" "$BOOT_NETWORK_LOG" 2>/dev/null || true
    ) &
}

run_pinned_checkout() {
    pinned=$1
    printf 'Rollback fixado em %s.\n' "$pinned"
    start_network_background
    record_boot_handoff rollback-local
    printf '\nIniciando ultimo OrdaX conhecido como valido...\n'
    if "$BIN_DIR/ordax-run"; then
        exit 0
    fi
    printf '\nUltimo checkout conhecido tambem falhou; entrando em recuperacao local.\n' >&2
    maintenance_shell
}

recover_previous_checkout() {
    failed_sha=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    is_commit_sha "$failed_sha" || return 1

    printf '\nOrdaX atual nao iniciou; tentando rollback automatico...\n' >&2
    if ! "$BIN_DIR/ordax-rollback"; then
        printf 'Rollback automatico indisponivel.\n' >&2
        return 1
    fi

    write_state "$BOOT_REJECTED_FILE" "$failed_sha"
    rolled_back=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    is_commit_sha "$rolled_back" || return 1
    [ "$rolled_back" != "$failed_sha" ] || return 1

    printf 'Rollback automatico ativado: %s -> %s\n' "$failed_sha" "$rolled_back"
    if "$BIN_DIR/ordax-run"; then
        exit 0
    fi
    printf 'Checkout anterior tambem falhou ao iniciar.\n' >&2
    return 1
}

maintenance_shell() {
    printf '\nBase de desenvolvimento pronta para manutencao.\n'
    printf 'Repositorio: %s\n' "$WORKTREE"
    printf 'Atualizar:    ordax-pull\n'
    printf 'Executar:     ordax-run\n'
    printf 'Voltar:       ordax-rollback\n'
    printf 'Rede:         ordax-network\n'
    printf '\nMudancas normais do OrdaX nao exigem regravar o pendrive.\n\n'

    # switch_root leaves the development init attached to the console file
    # descriptors but without a controlling TTY. Re-establish one before
    # entering maintenance so job control and password echo handling work.
    if [ -x /bin/setsid ]; then
        exec /bin/setsid -c /bin/sh
    fi
    exec /bin/sh
}

cmdline_value() {
    key=$1
    found=""
    for token in $(cat /proc/cmdline 2>/dev/null || true); do
        case "$token" in
            "$key="*)
                value=${token#*=}
                [ -z "$found" ] || return 1
                found=$value
                ;;
        esac
    done
    [ -n "$found" ] || return 1
    printf '%s' "$found"
}

rootfs_version_valid() {
    source_sha=$1
    is_commit_sha "$source_sha" || return 1
    root=$ROOTFS_VERSIONS_ROOT/$source_sha
    [ -d "$root" ] && [ ! -L "$root" ] || return 1
    [ -f "$root/.ordax-rootfs-commit" ] && [ ! -L "$root/.ordax-rootfs-commit" ] || return 1
    marker=$(cat "$root/.ordax-rootfs-commit" 2>/dev/null || true)
    [ "$marker" = "$source_sha" ] || return 1
    for required in bin/busybox bin/sh usr/bin/git sbin/ordax-dev-init usr/local/bin/ordax-run; do
        [ -x "$root/$required" ] && [ ! -L "$root/$required" ] || return 1
    done
    return 0
}

write_rootfs_slot_mapping() {
    slot=$1
    source_sha=$2
    case "$slot" in
        a|b) ;;
        *) return 1 ;;
    esac
    is_commit_sha "$source_sha" || return 1
    mkdir -p "$ROOTFS_SELECTION_DIR"
    write_state "$ROOTFS_SELECTION_DIR/slot-$slot" "$source_sha"
}

activate_versioned_rootfs() {
    source_sha=$1
    slot=$2
    mode=$3
    root=$ROOTFS_VERSIONS_ROOT/$source_sha

    rootfs_version_valid "$source_sha" || return 1
    mkdir -p "$root/.ordax-base"
    /bin/busybox mount -o bind "$root" "$root" || return 1

    for shared in state workspace home proc sys dev; do
        mkdir -p "$root/$shared"
        /bin/busybox mount -o bind "/$shared" "$root/$shared" || return 1
    done

    ORDAX_DEV_ROOT_SELECTED=1
    ORDAX_DEV_ROOT_COMMIT=$source_sha
    ORDAX_DEV_ROOT_SLOT=$slot
    ORDAX_DEV_ROOT_MODE=$mode
    ORDAX_DEV_VERSION_ROOT=/.ordax-base/versions
    export ORDAX_DEV_ROOT_SELECTED ORDAX_DEV_ROOT_COMMIT ORDAX_DEV_ROOT_SLOT
    export ORDAX_DEV_ROOT_MODE ORDAX_DEV_VERSION_ROOT

    cd "$root" || return 1
    /bin/busybox pivot_root . .ordax-base || return 1
    cd /
    exec /sbin/ordax-dev-init
}

candidate_root_failure() {
    message=$1
    printf '\nFalha ao ativar Base candidata: %s\n' "$message" >&2
    printf 'A candidata nao sera considerada saudavel; reiniciando para o slot conhecido como bom.\n' >&2
    /bin/busybox sync >/dev/null 2>&1 || true
    /bin/busybox sleep 1
    /bin/busybox reboot -f >/dev/null 2>&1 || maintenance_shell
    maintenance_shell
}

select_development_rootfs() {
    if [ "$ROOTFS_SELECTED" = "1" ]; then
        is_commit_sha "$ROOTFS_SELECTED_COMMIT" || {
            printf 'Identidade da Base selecionada e invalida; usando recuperacao local.\n' >&2
            maintenance_shell
        }
        ROOTFS_VERSIONS_ROOT=/.ordax-base/versions
        ORDAX_DEV_VERSION_ROOT=$ROOTFS_VERSIONS_ROOT
        export ROOTFS_VERSIONS_ROOT ORDAX_DEV_VERSION_ROOT
        return 0
    fi

    mkdir -p "$ROOTFS_SELECTION_DIR" "$ROOTFS_VERSIONS_ROOT"

    candidate_sha=$(cmdline_value ordax.base_candidate 2>/dev/null || true)
    base_slot=$(cmdline_value ordax.base_slot 2>/dev/null || true)

    if [ -n "$candidate_sha" ]; then
        is_commit_sha "$candidate_sha" || candidate_root_failure "identidade de commit invalida"
        case "$base_slot" in
            a|b) ;;
            *) candidate_root_failure "slot A/B ausente ou invalido" ;;
        esac
        rootfs_version_valid "$candidate_sha" || candidate_root_failure "rootfs exato nao esta materializado"
        write_rootfs_slot_mapping "$base_slot" "$candidate_sha"             || candidate_root_failure "nao foi possivel registrar o rootfs do slot"
        printf 'Base candidata %s preparada no slot %s; iniciando ensaio unico.\n' "$candidate_sha" "$base_slot"
        activate_versioned_rootfs "$candidate_sha" "$base_slot" candidate             || candidate_root_failure "troca de raiz falhou"
        return 0
    fi

    case "$base_slot" in
        a|b)
            mapping=$ROOTFS_SELECTION_DIR/slot-$base_slot
            if [ -s "$mapping" ] && [ ! -L "$mapping" ]; then
                mapped_sha=$(cat "$mapping" 2>/dev/null || true)
                if rootfs_version_valid "$mapped_sha"; then
                    printf 'Base versionada conhecida como boa: %s (slot %s).\n' "$mapped_sha" "$base_slot"
                    activate_versioned_rootfs "$mapped_sha" "$base_slot" current || {
                        printf 'Base versionada nao pode ser ativada; preservando Base seed conhecida como boa.\n' >&2
                    }
                    return 0
                fi
                printf 'Mapeamento do slot %s nao e utilizavel; preservando Base seed conhecida como boa.\n' "$base_slot" >&2
            fi
            ;;
    esac

    ORDAX_DEV_ROOT_COMMIT=seed
    ORDAX_DEV_ROOT_MODE=seed
    ORDAX_DEV_VERSION_ROOT=/versions
    export ORDAX_DEV_ROOT_COMMIT ORDAX_DEV_ROOT_MODE ORDAX_DEV_VERSION_ROOT
}

mkdir -p "$WORKSPACE_DIR" "$STATE_DIR" "$NETWORK_STATE_DIR" /home /run /tmp /root
chmod 1777 /tmp 2>/dev/null || true
select_development_rootfs

printf '\033[2J\033[H'
printf 'OrdaX Development Base\n'
printf 'Kernel + drivers + network + Git\n\n'

# Rollback pins start immediately. The running supervisor owns the remote retry:
# if this was an automatic boot rejection, it releases the pin only after main
# advances to a different commit. Manual pins remain sticky.
if [ -s "$PINNED_FILE" ]; then
    pinned=$(cat "$PINNED_FILE")
    current=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    if is_commit_sha "$pinned" && [ "$current" = "$pinned" ] && [ -x "$WORKTREE/system/entrypoint" ]; then
        run_pinned_checkout "$pinned"
    fi

    printf 'Estado de rollback fixado inconsistente; mantendo modo de recuperacao.\n' >&2
    printf 'PIN=%s HEAD=%s\n' "$pinned" "${current:-indisponivel}" >&2
    maintenance_shell
fi

# Normal boot is local-first. Network and Git are deliberately outside the
# critical path once a clean executable checkout exists.
if local_checkout_bootable; then
    current=$(git -C "$WORKTREE" rev-parse HEAD)
    printf 'Checkout local saudavel: %s\n' "$current"
    printf 'Boot rapido: rede e atualizacoes iniciam em paralelo.\n'
    start_network_background
    record_boot_handoff fast-local
    printf '\nIniciando OrdaX...\n'
    if "$BIN_DIR/ordax-run"; then
        exit 0
    fi
    printf '\nOrdaX local encerrou ou falhou ao iniciar.\n'
    recover_previous_checkout || maintenance_shell
fi

printf 'Primeiro boot ou checkout local inconsistente; preparando runtime pela rede.\n'

network_ok=0
if "$BIN_DIR/ordax-network"; then
    network_ok=1
else
    printf '\nRede ainda nao esta pronta.\n'
fi

pull_ok=0
if [ "$network_ok" -eq 1 ]; then
    attempt=1
    while [ "$attempt" -le "$BOOT_PULL_ATTEMPTS" ]; do
        printf 'Sincronizando OrdaX com a main (tentativa %s/%s)...\n' "$attempt" "$BOOT_PULL_ATTEMPTS"
        if "$BIN_DIR/ordax-pull"; then
            pull_ok=1
            break
        fi
        if [ "$attempt" -lt "$BOOT_PULL_ATTEMPTS" ]; then
            printf 'Sincronizacao falhou; repetindo uma vez apos pausa curta.\n'
            sleep 2
        fi
        attempt=$((attempt + 1))
    done
    if [ "$pull_ok" -eq 0 ]; then
        printf '\nNao foi possivel sincronizar a main apos %s tentativa(s).\n' "$BOOT_PULL_ATTEMPTS"
    fi
fi

if [ "$pull_ok" -eq 0 ] && [ -x "$WORKTREE/system/entrypoint" ]; then
    printf 'Usando o ultimo checkout local valido.\n'
fi

if [ -x "$WORKTREE/system/entrypoint" ]; then
    record_boot_handoff cold-network
    printf '\nIniciando OrdaX...\n'
    if "$BIN_DIR/ordax-run"; then
        exit 0
    fi
    printf '\nOrdaX encerrou ou falhou ao iniciar.\n'
    recover_previous_checkout || true
else
    printf '\nAinda nao existe um checkout executavel em %s.\n' "$WORKTREE"
fi

maintenance_shell

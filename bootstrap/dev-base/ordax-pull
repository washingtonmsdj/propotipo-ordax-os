#!/bin/sh
set -eu

REPO_URL=${ORDAX_REPO_URL:-https://github.com/washingtonmsdj/prototipo-ordax-os.git}
BRANCH=${ORDAX_REPO_BRANCH:-main}
WORKTREE=${ORDAX_WORKTREE:-/workspace/ordax}
STATE_DIR=${ORDAX_STATE_DIR:-/state/ordax}
PREVIOUS_FILE=$STATE_DIR/previous-commit
CURRENT_FILE=$STATE_DIR/current-commit
PINNED_FILE=$STATE_DIR/pinned-commit
DIRTY_CHECKOUT_DIR=$STATE_DIR/dirty-checkout
GIT_TIMEOUT_SECONDS=${ORDAX_BOOT_GIT_TIMEOUT_SECONDS:-45}
GIT_LOW_SPEED_TIME=${ORDAX_BOOT_GIT_LOW_SPEED_SECONDS:-15}

case "$GIT_TIMEOUT_SECONDS" in
    ''|*[!0-9]*) GIT_TIMEOUT_SECONDS=45 ;;
esac
[ "$GIT_TIMEOUT_SECONDS" -ge 10 ] 2>/dev/null || GIT_TIMEOUT_SECONDS=45

case "$GIT_LOW_SPEED_TIME" in
    ''|*[!0-9]*) GIT_LOW_SPEED_TIME=15 ;;
esac
[ "$GIT_LOW_SPEED_TIME" -ge 5 ] 2>/dev/null || GIT_LOW_SPEED_TIME=15

GIT_TERMINAL_PROMPT=0
export GIT_TERMINAL_PROMPT

run_bounded_git() {
    timeout -k 5 "$GIT_TIMEOUT_SECONDS" \
        git \
        -c http.lowSpeedLimit=1 \
        -c "http.lowSpeedTime=$GIT_LOW_SPEED_TIME" \
        "$@"
}

write_state() {
    destination=$1
    value=$2
    temporary=$destination.tmp.$
    printf '%s\n' "$value" > "$temporary"
    mv -f "$temporary" "$destination"
}

record_dirty_checkout() {
    mkdir -p "$DIRTY_CHECKOUT_DIR"
    chmod 700 "$DIRTY_CHECKOUT_DIR" 2>/dev/null || true

    head=$(
        git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true
    )
    status_file=$DIRTY_CHECKOUT_DIR/last-status.txt
    status_tmp=$status_file.tmp.$
    {
        printf 'head=%s\n' "${head:-unknown}"
        git -C "$WORKTREE" status --porcelain=v1 2>/dev/null || true
    } >"$status_tmp"
    mv -f "$status_tmp" "$status_file"

    patch_file=$DIRTY_CHECKOUT_DIR/last-tracked-changes.patch
    patch_tmp=$patch_file.tmp.$
    if run_bounded_git -C "$WORKTREE" diff --binary --no-ext-diff HEAD >"$patch_tmp" 2>/dev/null; then
        mv -f "$patch_tmp" "$patch_file"
    else
        rm -f "$patch_tmp"
    fi
}

repair_dirty_checkout() {
    record_dirty_checkout
    echo "ordax-git: checkout local alterado; restaurando cache controlado pelo Git" >&2

    if ! run_bounded_git -C "$WORKTREE" reset --hard HEAD >/dev/null 2>&1; then
        echo "ordax-git: nao foi possivel restaurar arquivos rastreados; checkout preservado" >&2
        return 1
    fi
    if ! run_bounded_git -C "$WORKTREE" clean -ffd >/dev/null 2>&1; then
        echo "ordax-git: nao foi possivel remover residuos nao rastreados; checkout preservado" >&2
        return 1
    fi
    if [ -n "$(git -C "$WORKTREE" status --porcelain 2>/dev/null || true)" ]; then
        echo "ordax-git: checkout continua inconsistente apos restauracao automatica" >&2
        return 1
    fi

    echo "ordax-git: checkout local restaurado; diagnostico preservado em $DIRTY_CHECKOUT_DIR" >&2
    return 0
}

configure_runtime_checkout() {
    git -C "$WORKTREE" sparse-checkout set --no-cone \
        /system/ \
        /bootstrap/trust/ \
        /bootstrap/config/release-envelope-url \
        /docs/contracts/release-trust-policy.json \
        /docs/contracts/minimal-bootstrap.json \
        /docs/evidence/release-trust-ceremony.json \
        /docs/evidence/release-trust-proof-manifest.json \
        /docs/evidence/release-trust-recovery-envelope.json
}

mkdir -p "$(dirname "$WORKTREE")" "$STATE_DIR"

if [ ! -d "$WORKTREE/.git" ]; then
    echo "ordax-git: clonando runtime de $REPO_URL ($BRANCH)"
    run_bounded_git clone \
        --branch "$BRANCH" \
        --single-branch \
        --filter=blob:none \
        --sparse \
        "$REPO_URL" \
        "$WORKTREE"
    configure_runtime_checkout
else
    origin_url=$(git -C "$WORKTREE" remote get-url origin)
    [ "$origin_url" = "$REPO_URL" ] || {
        echo "ordax-git: origin inesperado: $origin_url" >&2
        exit 1
    }

    current_branch=$(git -C "$WORKTREE" symbolic-ref --quiet --short HEAD || true)
    [ "$current_branch" = "$BRANCH" ] || {
        echo "ordax-git: branch local inesperada: ${current_branch:-detached}" >&2
        exit 1
    }

    if [ -n "$(git -C "$WORKTREE" status --porcelain 2>/dev/null || true)" ]; then
        repair_dirty_checkout || exit 1
    fi

    previous=$(git -C "$WORKTREE" rev-parse HEAD)
    echo "ordax-git: git pull --ff-only origin $BRANCH"
    run_bounded_git -C "$WORKTREE" pull --ff-only origin "$BRANCH"
    configure_runtime_checkout

    current=$(git -C "$WORKTREE" rev-parse HEAD)
    if [ "$current" != "$previous" ]; then
        write_state "$PREVIOUS_FILE" "$previous"
    fi
fi

current=$(git -C "$WORKTREE" rev-parse HEAD)
write_state "$CURRENT_FILE" "$current"
rm -f "$PINNED_FILE"
printf 'ORDAX_SOURCE_SHA=%s\n' "$current"

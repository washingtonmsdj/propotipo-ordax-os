#!/bin/sh
set -eu

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

STATE_DIR=/state/network
WPA_CONF=$STATE_DIR/wpa.conf
mkdir -p "$STATE_DIR" /run

have_ipv4() {
    ip -4 -o addr show scope global 2>/dev/null | grep -q ' inet '
}

try_dhcp() {
    iface=$1
    ip link set "$iface" up >/dev/null 2>&1 || return 1
    udhcpc -n -q -t 4 -T 3 -i "$iface" >/dev/null 2>&1 || return 1
    have_ipv4
}

if have_ipv4; then
    echo "ordax-network: rede ja disponivel"
    exit 0
fi

# Only Ethernet-like non-wireless interfaces are valid candidates for the
# wired/USB-tether DHCP pass. Kernel-created tunnels such as sit0 also appear
# in /sys/class/net, but are not physical/tether interfaces and must not delay
# boot with pointless DHCP attempts.
for netpath in /sys/class/net/*; do
    [ -e "$netpath" ] || continue
    iface=${netpath##*/}
    [ "$iface" = lo ] && continue
    [ -d "$netpath/wireless" ] && continue
    net_type=$(cat "$netpath/type" 2>/dev/null || true)
    [ "$net_type" = 1 ] || continue
    echo "ordax-network: tentando DHCP em $iface"
    if try_dhcp "$iface"; then
        echo "ordax-network: conectado em $iface"
        exit 0
    fi
done

wifi=""
for netpath in /sys/class/net/*; do
    [ -d "$netpath/wireless" ] || continue
    wifi=${netpath##*/}
    break
done

[ -n "$wifi" ] || {
    echo "ordax-network: nenhuma interface Wi-Fi detectada; use Ethernet ou tethering USB" >&2
    exit 1
}

ip link set "$wifi" up >/dev/null 2>&1 || true

wait_for_wifi_link() {
    attempts=0
    while [ "$attempts" -lt 12 ]; do
        if iw dev "$wifi" link 2>/dev/null | grep -q '^Connected to '; then
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 1
    done
    return 1
}

connect_saved_wifi() {
    [ -s "$WPA_CONF" ] || return 1
    killall wpa_supplicant >/dev/null 2>&1 || true
    wpa_supplicant -B -i "$wifi" -c "$WPA_CONF" >/dev/null 2>&1 || return 1
    if ! wait_for_wifi_link; then
        killall wpa_supplicant >/dev/null 2>&1 || true
        return 1
    fi
    try_dhcp "$wifi"
}

if connect_saved_wifi; then
    echo "ordax-network: Wi-Fi conectado em $wifi"
    exit 0
fi

echo "ordax-network: redes Wi-Fi detectadas:"
iw dev "$wifi" scan 2>/dev/null \
    | awk -F': ' '/^[[:space:]]*SSID: / {print $2}' \
    | sed '/^$/d' | sort -u | head -30 || true

printf 'SSID (nome exato da rede acima, nao a senha): '
IFS= read -r ssid
[ -n "$ssid" ] || {
    echo "ordax-network: SSID vazio" >&2
    exit 1
}

printf 'Senha WPA/WPA2: '
stty -echo 2>/dev/null || true
IFS= read -r password
stty echo 2>/dev/null || true
printf '\n'
[ -n "$password" ] || {
    echo "ordax-network: este bootstrap de desenvolvimento espera uma senha WPA/WPA2" >&2
    exit 1
}

umask 077
wpa_passphrase "$ssid" "$password" | sed '/^[[:space:]]*#psk=/d' > "$WPA_CONF"
unset password

if connect_saved_wifi; then
    echo "ordax-network: Wi-Fi conectado em $wifi"
    exit 0
fi

echo "ordax-network: a associacao Wi-Fi ou o DHCP nao concluiu em $wifi" >&2
echo "ordax-network: execute ordax-network novamente e confirme o SSID exato listado acima" >&2
exit 1

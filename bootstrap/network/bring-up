#!/bin/sh
set -eu

NETBOX=/ordax/bootstrap/network/bin/netbox
DHCP_SCRIPT=/ordax/bootstrap/network/udhcpc.script
STATE_DIR=/run/ordax-network

log() {
    echo "ordax-network: $*" >&2
}

[ -x "$NETBOX" ] || {
    log "network userspace is missing"
    exit 1
}
[ -x "$DHCP_SCRIPT" ] || {
    log "DHCP script is missing"
    exit 1
}

mkdir -p "$STATE_DIR" /etc

for path in /sys/class/net/*; do
    [ -e "$path" ] || continue
    iface=${path##*/}
    [ "$iface" = lo ] && continue

    log "trying DHCP on $iface"
    "$NETBOX" ifconfig "$iface" up >/dev/null 2>&1 || continue

    pidfile="$STATE_DIR/udhcpc-$iface.pid"
    rm -f "$pidfile"
    if "$NETBOX" udhcpc -n -q -t 4 -T 3 -i "$iface" -s "$DHCP_SCRIPT" -p "$pidfile"; then
        status="$("$NETBOX" ifconfig "$iface" 2>/dev/null || true)"
        case "$status" in
            *"inet addr:"*|*"inet "*)
                printf '%s\n' "$iface" > "$STATE_DIR/active-interface"
                log "network ready on $iface"
                exit 0
                ;;
        esac
    fi
done

log "no DHCP-capable Ethernet/USB-tether interface became ready"
exit 1

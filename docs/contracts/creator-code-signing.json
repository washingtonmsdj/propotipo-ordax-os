{
  "$schema": "prototype-ordax.creator-code-signing/2",
  "status": "unconfigured",
  "platform": "windows",
  "artifacts": [
    "OrdaX-Creator.exe",
    "OrdaX-Creator-App.exe"
  ],
  "artifact_roles": {
    "OrdaX-Creator.exe": "stable-signed-app-loader",
    "OrdaX-Creator-App.exe": "versioned-signed-creator-gui"
  },
  "signature_format": "authenticode",
  "file_digest_algorithm": "sha256",
  "timestamp": {
    "required": true,
    "protocol": "rfc3161",
    "digest_algorithm": "sha256"
  },
  "publisher_identity": {
    "expected_subject": null,
    "allowed_leaf_certificate_sha256": []
  },
  "verification": {
    "windows_signature_status_required": "Valid",
    "windows_trust_chain_required": true,
    "exact_publisher_subject_required": true,
    "leaf_certificate_sha256_pin_required": true,
    "timestamp_certificate_required": true,
    "exact_artifact_name_required": true
  },
  "custody": {
    "provider": "unconfigured",
    "private_key_may_enter_git": false,
    "private_key_may_enter_creator": false,
    "private_key_may_enter_github_artifact": false,
    "pfx_may_enter_git": false,
    "pfx_may_enter_github_artifact": false,
    "end_user_manages_code_signing_key": false
  },
  "release_policy": {
    "unsigned_candidate_publishable": false,
    "signature_with_unapproved_identity_publishable": false,
    "signature_without_timestamp_publishable": false,
    "unlisted_artifact_publishable": false,
    "authenticode_is_release_authenticity_root": false,
    "ed25519_release_verification_remains_required": true,
    "publish_allowed": false
  }
}

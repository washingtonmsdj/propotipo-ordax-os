# OrdaX replaceable Native Surface runtime contract.
# This file is sourced by BusyBox ash and parsed by build tooling.
# Keep values as single-quoted literal assignments only.
ORDAX_NATIVE_SURFACE_RUNTIME_SCHEMA='ordax.native-surface-runtime/1'
ORDAX_NATIVE_SURFACE_RUNTIME_ID='alpine-v3.22-cage-webkitgtk-v1'
ORDAX_NATIVE_SURFACE_REPOSITORY_MAIN='https://dl-cdn.alpinelinux.org/alpine/v3.22/main'
ORDAX_NATIVE_SURFACE_REPOSITORY_COMMUNITY='https://dl-cdn.alpinelinux.org/alpine/v3.22/community'
ORDAX_NATIVE_SURFACE_INSTALL_PACKAGES='alpine-baselayout busybox ca-certificates cage xwayland python3 py3-gobject3 gtk+3.0 webkit2gtk-4.1 seatd-launch mesa-dri-gallium mesa-egl mesa-gbm font-dejavu eudev libinput-udev'
ORDAX_NATIVE_SURFACE_UPGRADE_PACKAGES='xwayland eudev libinput-udev python3 py3-gobject3 gtk+3.0 webkit2gtk-4.1'
ORDAX_NATIVE_SURFACE_BASE_EXECUTABLES='usr/bin/cage usr/bin/python3 usr/bin/seatd-launch bin/busybox'
ORDAX_NATIVE_SURFACE_BASE_FILES='usr/lib/girepository-1.0/Gtk-3.0.typelib usr/lib/girepository-1.0/WebKit2-4.1.typelib'
ORDAX_NATIVE_SURFACE_FULL_EXECUTABLES='usr/bin/cage usr/bin/python3 usr/bin/seatd-launch bin/busybox usr/bin/Xwayland sbin/udevd bin/udevadm'
ORDAX_NATIVE_SURFACE_FULL_FILES='usr/lib/girepository-1.0/Gtk-3.0.typelib usr/lib/girepository-1.0/WebKit2-4.1.typelib usr/lib/udev/rules.d/60-input-id.rules'

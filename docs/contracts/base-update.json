{
  "$schema": "prototype-ordax.base-update/1",
  "status": "legacy-transition-and-postboot-promotion-proof",
  "scope": "transactional-boot-kernel-initramfs-update",
  "owner": "bootstrap/base-update",
  "normal_git_hot_update_owns_this": false,
  "requires_reboot_to_activate": true,
  "esp": {
    "filesystem_label": "ORDAX-ESP",
    "filesystem": "fat32",
    "mount_policy": "private-temporary-mount-by-owner-only"
  },
  "slots": {
    "names": [
      "a",
      "b"
    ],
    "active_slot_must_not_be_modified_during_stage": true,
    "paths": {
      "kernel": "/ordax/base/{slot}/vmlinuz",
      "initramfs": "/ordax/base/{slot}/initrd.gz"
    },
    "inactive_slot_only_for_candidate": true
  },
  "entries": {
    "current": "/loader/entries/ordax.conf",
    "recovery": "/loader/entries/ordax-recovery.conf",
    "candidate_template": "/loader/entries/ordax-candidate+01-00.conf",
    "candidate_kernel_options": [
      "ordax.mode=normal",
      "ordax.base_slot={slot}",
      "ordax.base_candidate={release_sha}"
    ],
    "current_and_recovery_are_never_replaced_before_candidate_health": true
  },
  "activation": {
    "selector": "LoaderEntryOneShot",
    "bootloader": "systemd-boot",
    "boot_counting_required": true,
    "candidate_tries_left": 1,
    "default_entry_unchanged_before_health": true,
    "automatic_fallback": "existing-current-entry",
    "reboot_required": true,
    "entry_id": "ordax-candidate.conf"
  },
  "staging": {
    "signed_manifest_required": true,
    "release_envelope_schema": "prototype-ordax.release-envelope/1",
    "release_manifest_schema": "prototype-ordax.release-manifest/1",
    "canonical_trust_path": "/ordax/bootstrap/trust/release-ed25519.json",
    "verifier": "/ordax/bootstrap/release-acquisition/ordax-release-agent verify-envelope",
    "signed_system_artifact_required": true,
    "signed_candidate_descriptor": "system/base-update/candidate.json",
    "verified_release_root": "/ordax/releases/{release_sha}",
    "unsigned_candidate_cli_allowed": false,
    "kernel_sha256_required": true,
    "initramfs_sha256_required": true,
    "same_release_identity_required": true,
    "write_inactive_slot_first": true,
    "fsync_files_before_entry": true,
    "fsync_esp_before_activation": true,
    "candidate_entry_written_last": true,
    "materializer": "/ordax/bootstrap/release-acquisition/ordax-release-agent materialize",
    "materialize_expected_commit_required": true,
    "materialize_only_when_boot_refresh_pending": true,
    "materialization_must_not_change_current_pointer": true,
    "materialization_precedes_esp_stage": true,
    "persisted_verified_envelope": "/ordax/releases/{release_sha}/release-envelope.json",
    "stager_must_use_persisted_verified_envelope": true,
    "second_envelope_network_fetch_for_stage": false
  },
  "health": {
    "candidate_cmdline_identity_required": true,
    "base_heartbeat_required": true,
    "surface_health_required": true,
    "same_release_sha_required": true,
    "promotion_only_after_all_checks": true,
    "local_evidence": {
      "base_heartbeat": "/state/ordax/base-update/base-heartbeat.json",
      "surface_health": "/run/ordax-update/healthy-sha",
      "surface_heartbeat": "/state/ordax/native-state/surface-heartbeat.json",
      "boot_id": "/run/ordax-update/base-boot-id",
      "cmdline": "/proc/cmdline"
    },
    "boot_id_must_match_across_base_and_surface": true,
    "boot_id_source": "guardian-generated-random-session-id-in-tmpfs"
  },
  "promotion": {
    "current_entry_retargeted_to_candidate_slot": true,
    "recovery_entry_retargeted_to_previous_slot": true,
    "atomic_replace_required": true,
    "candidate_entry_removed_after_promotion": true,
    "previous_slot_preserved": true,
    "active_slot_record": "/ordax/state/base/active-slot.json",
    "current_entry_written_after_recovery_entry": true,
    "current_entry_is_promotion_commit_point": true,
    "candidate_entry_removed_before_current_commit": true,
    "post_commit_metadata_may_not_reclassify_promotion_as_precommit_failure": true,
    "development_state_alias": "/state/ordax",
    "boot_refresh_marker": "/ordax/state/boot-refresh-required",
    "boot_refresh_marker_development_alias": "/state/ordax/boot-refresh-required",
    "boot_refresh_marker_cleared_only_after_healthy_promotion": true,
    "normal_reboot_must_not_clear_boot_refresh_marker": true,
    "current_entry_durability_reported": true
  },
  "failure": {
    "current_entry_remains_unchanged": true,
    "previous_slot_remains_bootable": true,
    "candidate_never_promoted_without_health": true,
    "no_whole_esp_rewrite": true,
    "no_kernel_in_place_overwrite": true,
    "no_remote_shell_required": true
  },
  "implementation_gates": [
    "contract-tests",
    "disposable-fat32-esp-proof",
    "systemd-boot-entry-proof",
    "one-shot-selection-proof",
    "one-shot-efivar-proof",
    "failed-candidate-fallback-proof",
    "successful-candidate-promotion-proof",
    "physical-notebook-proof"
  ],
  "legacy_transition": {
    "initial_layout": "single-slot-legacy",
    "legacy_kernel": "/ordax/vmlinuz",
    "legacy_initramfs": "/ordax/initrd.gz",
    "legacy_current_entry": "/loader/entries/ordax.conf",
    "legacy_recovery_entry": "/loader/entries/ordax-recovery.conf",
    "previous_slot": "a",
    "candidate_slot": "b",
    "preserve_legacy_bytes_to_previous_slot_before_candidate": true,
    "baseline_copy_requires_exact_hash_identity": true,
    "conflicting_or_unsafe_baseline_fails_closed": true,
    "candidate_marker_blocks_before_baseline_mutation": true,
    "legacy_current_and_recovery_remain_unchanged_before_health": true,
    "legacy_kernel_and_initramfs_remain_unchanged_before_health": true,
    "failed_candidate_fallback": "unchanged-legacy-current-entry",
    "successful_promotion": {
      "current_slot": "b",
      "recovery_slot": "a",
      "legacy_source_bytes_may_remain_unreferenced": true
    }
  },
  "release_agent_refresh": {
    "schema": "prototype-ordax.release-agent-refresh/1",
    "descriptor": "system/services/base-update/release-agent-refresh.json",
    "target": "/ordax/bootstrap/release-acquisition/ordax-release-agent",
    "authority": "git-checkout-pinned-sha256-and-size",
    "channel": "github-release-hash-addressed",
    "initial_supported_migration": {
      "from_sha256": [
        "9d76eec25ba07c436b21aa59ea88b5c972e531ebd8ec345cf10aa590fb8122f4",
        "19f36d913321d9f073717f335b52d6850856cca6c98fa4dec4136738b6ff35e0"
      ],
      "to_sha256": "74a03bd9901c33b7281d529fb0d379a735d20b5ef7495e0af2f73ca2ff40c90e"
    },
    "unknown_installed_hash": "block",
    "replacement": "same-directory-temp-fsync-atomic-replace",
    "occurs_before_canonical_trust_enrollment": true,
    "physical_media_rewrite_required": false,
    "raw_device_write_allowed": false,
    "generic_bootstrap_updater_created": false,
    "absent_agent_enrollment": true,
    "absent_agent_enrollment_requires_explicit_descriptor_gate": true,
    "existing_unknown_hash_still_blocks": true,
    "target_persists_verified_envelope": true
  },
  "runtime_owner": {
    "development_host_state_root": "/state/ordax",
    "graphical_native_state_root": "/var/lib/ordax",
    "graphical_native_state_is_not_base_owner_state_root": true,
    "physical_root_discovery": "/proc/self/mountinfo root mount",
    "physical_root_required_filesystem": "ext4",
    "physical_root_required_source_prefix": "/dev/",
    "physical_root_chroot_mount": "/mnt/ordax-device",
    "development_state_inside_physical_root": "<seed-root-subpath>/state/ordax",
    "state_root_derived_from_mountinfo_subpath": true,
    "recursive_state_bind_forbidden": true,
    "mount_staging_host": "/run/ordax-base-owner",
    "mount_staging_filesystem": "tmpfs",
    "mount_staging_size": "1m",
    "physical_root_host_mount": "/run/ordax-base-owner/physical",
    "physical_root_bound_into_chroot": true,
    "mount_tree_must_not_recurse_into_ordax_filesystem": true,
    "physical_release_agent_may_be_absent_before_pinned_enrollment": true,
    "physical_release_channel_may_be_absent_before_pinned_enrollment": true,
    "bootstrap_component_sentinels_not_required_before_pinned_enrollment": true,
    "versioned_root_subpath_normalization": "strip-terminal-/versions/<commit>-before-seed-state-and-version-store-resolution",
    "development_version_store_inside_physical_root": "<seed-root-subpath>/versions"
  },
  "release_channel_enrollment": {
    "source_path": "bootstrap/config/release-envelope-url",
    "target": "/ordax/bootstrap/config/release-envelope-url",
    "authority": "minimal-bootstrap-sha256",
    "expected_sha256": "ea1f3bae328a1c1e7aca1474d4930f84b2dd6da1702dcc11b08c01ed63a6ee5b",
    "mode": "0644",
    "absent_channel_enrollment": true,
    "existing_divergent_channel": "block",
    "occurs_after_release_agent_refresh": true,
    "occurs_before_canonical_trust_enrollment": true,
    "physical_media_rewrite_required": false,
    "raw_device_write_allowed": false
  }
}

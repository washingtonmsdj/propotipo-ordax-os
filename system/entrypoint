#!/bin/sh
set -eu

SYSTEM_ROOT=${0%/*}
SYSTEM_ENTRYPOINT=$SYSTEM_ROOT/entrypoint
SUPERVISOR=$SYSTEM_ROOT/supervisor
RECOVERY_ENTRYPOINT=/ordax/bootstrap/recovery/entrypoint
UPDATE_RUN_DIR=${ORDAX_UPDATE_RUN_DIR:-/run/ordax-update}
UPDATE_STATE=$UPDATE_RUN_DIR/state.json
WORKTREE=${ORDAX_WORKTREE:-/workspace/ordax}
GIT_BIN=${ORDAX_GIT_BIN:-/usr/bin/git}
BASE_UPDATE_STATE_DIR=${ORDAX_BASE_UPDATE_STATE_DIR:-/state/ordax/base-update}
BASE_HEARTBEAT_FILE=$BASE_UPDATE_STATE_DIR/base-heartbeat.json
BASE_BOOT_ID_FILE=$UPDATE_RUN_DIR/base-boot-id
CMDLINE_FILE=/proc/cmdline
GUARDIAN_PID_FILE=$UPDATE_RUN_DIR/guardian.pid
SUPERVISOR_PID_FILE=$UPDATE_RUN_DIR/supervisor.pid
GUARDIAN_LOG=$UPDATE_RUN_DIR/guardian.log
CHECK_INTERVAL=${ORDAX_GUARDIAN_CHECK_SECONDS:-10}
STALE_SECONDS=${ORDAX_SUPERVISOR_STALE_SECONDS:-120}
CRASH_LIMIT=${ORDAX_SUPERVISOR_CRASH_LIMIT:-3}
STABLE_SECONDS=${ORDAX_SUPERVISOR_STABLE_SECONDS:-60}
SUPERVISOR_PID=""
STOPPING=0

mkdir -p "$UPDATE_RUN_DIR"
chmod 700 "$UPDATE_RUN_DIR"

log() {
    printf '%s ordax-guardian: %s\n' "$(/bin/busybox date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf unknown)" "$*" >>"$GUARDIAN_LOG"
}

normalize_number() {
    value=$1
    fallback=$2
    minimum=$3
    case "$value" in
        ''|*[!0-9]*) value=$fallback ;;
    esac
    [ "$value" -ge "$minimum" ] 2>/dev/null || value=$fallback
    printf '%s' "$value"
}

CHECK_INTERVAL=$(normalize_number "$CHECK_INTERVAL" 10 5)
STALE_SECONDS=$(normalize_number "$STALE_SECONDS" 120 60)
CRASH_LIMIT=$(normalize_number "$CRASH_LIMIT" 3 2)
STABLE_SECONDS=$(normalize_number "$STABLE_SECONDS" 60 30)

epoch_now() {
    /bin/busybox date +%s 2>/dev/null || printf '0\n'
}

state_epoch() {
    [ -f "$UPDATE_STATE" ] || {
        printf '0\n'
        return 0
    }
    /bin/busybox stat -c %Y "$UPDATE_STATE" 2>/dev/null || printf '0\n'
}

is_pid() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 1 ] 2>/dev/null
}

write_pid() {
    destination=$1
    value=$2
    temporary=$destination.tmp.$
    printf '%s\n' "$value" >"$temporary"
    /bin/busybox mv -f "$temporary" "$destination"
}

is_sha() {
    value=${1:-}
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
}

ensure_base_boot_id() {
    current=""
    if [ -r "$BASE_BOOT_ID_FILE" ]; then
        current=$(/bin/busybox cat "$BASE_BOOT_ID_FILE" 2>/dev/null || true)
    fi
    case "$current" in
        ????????????????????????????????) 
            case "$current" in *[!0-9a-f]*) current="" ;; esac
            ;;
        *) current="" ;;
    esac
    [ -n "$current" ] && return 0

    generated=$(/bin/busybox od -An -N16 -tx1 /dev/urandom 2>/dev/null | /bin/busybox tr -d ' \n' || true)
    [ "${#generated}" -eq 32 ] || return 1
    case "$generated" in *[!0-9a-f]*) return 1 ;; esac

    temporary=$BASE_BOOT_ID_FILE.tmp.$
    printf '%s\n' "$generated" >"$temporary"
    chmod 600 "$temporary"
    /bin/busybox mv -f "$temporary" "$BASE_BOOT_ID_FILE"
}

cmdline_value() {
    key=$1
    [ -r "$CMDLINE_FILE" ] || return 1
    found=""
    for token in $(/bin/busybox cat "$CMDLINE_FILE"); do
        case "$token" in
            "$key="*)
                value=${token#*=}
                [ -z "$found" ] || return 1
                found=$value
                ;;
        esac
    done
    [ -n "$found" ] || return 1
    printf '%s' "$found"
}

write_base_update_heartbeat() {
    candidate=$(cmdline_value ordax.base_candidate 2>/dev/null || true)
    slot=$(cmdline_value ordax.base_slot 2>/dev/null || true)

    if [ -z "$candidate" ] && [ -z "$slot" ]; then
        rm -f "$BASE_HEARTBEAT_FILE" >/dev/null 2>&1 || true
        return 0
    fi

    is_sha "$candidate" || {
        log "candidate base heartbeat rejected invalid release identity"
        rm -f "$BASE_HEARTBEAT_FILE" >/dev/null 2>&1 || true
        return 0
    }
    case "$slot" in a|b) ;; *)
        log "candidate base heartbeat rejected invalid slot"
        rm -f "$BASE_HEARTBEAT_FILE" >/dev/null 2>&1 || true
        return 0
    esac

    source_sha=$("$GIT_BIN" -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    is_sha "$source_sha" || {
        log "candidate base heartbeat could not resolve current release"
        return 0
    }
    boot_id=$(/bin/busybox cat "$BASE_BOOT_ID_FILE" 2>/dev/null || true)
    [ "${#boot_id}" -eq 32 ] || {
        log "candidate base heartbeat could not resolve boot session id"
        return 0
    }
    case "$boot_id" in
        *[!0-9a-f]*) log "candidate base heartbeat rejected invalid boot session id"; return 0 ;;
    esac

    /bin/busybox mkdir -p "$BASE_UPDATE_STATE_DIR"
    chmod 700 "$BASE_UPDATE_STATE_DIR"
    temporary=$BASE_HEARTBEAT_FILE.tmp.$
    printf '{"$schema":"prototype-ordax.base-heartbeat/1","candidateSha":"%s","sourceSha":"%s","slot":"%s","bootId":"%s"}\n' \
        "$candidate" "$source_sha" "$slot" "$boot_id" >"$temporary"
    chmod 600 "$temporary"
    /bin/busybox mv -f "$temporary" "$BASE_HEARTBEAT_FILE"
}

terminate_supervisor() {
    pid=${SUPERVISOR_PID:-}
    is_pid "$pid" || return 0
    kill -0 "$pid" >/dev/null 2>&1 || return 0

    kill "$pid" >/dev/null 2>&1 || true
    remaining=5
    while kill -0 "$pid" >/dev/null 2>&1 && [ "$remaining" -gt 0 ]; do
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    if kill -0 "$pid" >/dev/null 2>&1; then
        log "forcing stalled supervisor pid $pid"
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    wait "$pid" 2>/dev/null || true
}

cleanup() {
    STOPPING=1
    terminate_supervisor
    rm -f "$SUPERVISOR_PID_FILE" "$GUARDIAN_PID_FILE" >/dev/null 2>&1 || true
}

terminate() {
    trap - EXIT HUP INT TERM
    cleanup
    exit 0
}

fail_closed() {
    reason=$1
    log "$reason"
    terminate_supervisor
    rm -f "$SUPERVISOR_PID_FILE" "$GUARDIAN_PID_FILE" >/dev/null 2>&1 || true
    if [ -x "$RECOVERY_ENTRYPOINT" ]; then
        trap - EXIT HUP INT TERM
        exec "$RECOVERY_ENTRYPOINT"
    fi
    exit 1
}

start_supervisor() {
    [ -f "$SUPERVISOR" ] || return 1
    /bin/sh -n "$SUPERVISOR" >>"$GUARDIAN_LOG" 2>&1 || return 1
    /bin/sh "$SUPERVISOR" >>"$GUARDIAN_LOG" 2>&1 &
    SUPERVISOR_PID=$!
    write_pid "$SUPERVISOR_PID_FILE" "$SUPERVISOR_PID"
    log "started supervisor pid $SUPERVISOR_PID"
    return 0
}

trap cleanup EXIT
trap terminate HUP INT TERM

write_pid "$GUARDIAN_PID_FILE" "$"
log "guardian started pid=$"
write_base_update_heartbeat

consecutive_failures=0

while :; do
    start_supervisor || fail_closed "supervisor script is missing or invalid"

    started_at=$(epoch_now)
    stale_restart=0

    while is_pid "$SUPERVISOR_PID" && kill -0 "$SUPERVISOR_PID" >/dev/null 2>&1; do
        /bin/busybox sleep "$CHECK_INTERVAL"
        [ "$STOPPING" -eq 0 ] || exit 0

        now=$(epoch_now)
        heartbeat=$(state_epoch)
        case "$now:$heartbeat" in
            *[!0-9:]*|'0:'*|*:0) continue ;;
        esac

        age=$((now - heartbeat))
        if [ "$age" -gt "$STALE_SECONDS" ] 2>/dev/null; then
            log "supervisor heartbeat stale for ${age}s; restarting child"
            stale_restart=1
            terminate_supervisor
            break
        fi
    done

    supervisor_rc=0
    if [ "$stale_restart" -eq 0 ]; then
        wait "$SUPERVISOR_PID" 2>/dev/null || supervisor_rc=$?
    else
        supervisor_rc=124
    fi
    rm -f "$SUPERVISOR_PID_FILE" >/dev/null 2>&1 || true
    SUPERVISOR_PID=""

    if [ "$supervisor_rc" -eq 75 ]; then
        log "supervisor requested guardian refresh"
        trap - EXIT HUP INT TERM
        exec "$SYSTEM_ENTRYPOINT"
    fi

    ended_at=$(epoch_now)
    runtime=0
    case "$started_at:$ended_at" in
        *[!0-9:]*|'0:'*|*:0) runtime=0 ;;
        *) runtime=$((ended_at - started_at)) ;;
    esac

    if [ "$runtime" -ge "$STABLE_SECONDS" ] 2>/dev/null; then
        consecutive_failures=0
    else
        consecutive_failures=$((consecutive_failures + 1))
    fi

    log "supervisor exited rc=$supervisor_rc runtime=${runtime}s failures=$consecutive_failures"

    if [ "$consecutive_failures" -ge "$CRASH_LIMIT" ] 2>/dev/null; then
        fail_closed "supervisor exceeded crash budget"
    fi

    /bin/busybox sleep 2
done

#!/bin/sh
set -eu

SYSTEM_ROOT=${ORDAX_SYSTEM_ROOT:-}
RUNTIME_DIR=/run/ordax-surface
HTTP_LOG=$RUNTIME_DIR/http.log
HOST_LOG=$RUNTIME_DIR/host.log
HTTP_PID=""

cleanup() {
    if [ -n "$HTTP_PID" ]; then
        kill "$HTTP_PID" >/dev/null 2>&1 || true
        wait "$HTTP_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT HUP INT TERM

console_fallback() {
    printf '\033[2J\033[H'
    printf 'OrdaX\n'
    printf 'Surface native host fallback\n'
    printf 'Release root: %s\n' "${SYSTEM_ROOT:-unknown}"
    printf 'Mode: %s\n' "${ORDAX_SURFACE_MODE:-unknown}"
    printf '\nThe graphical host could not be started.\n'
    printf 'Host log: %s\n' "$HOST_LOG"
    printf 'The verified system checkout remains available for maintenance.\n'
    trap 'exit 0' HUP INT TERM
    while :; do
        sleep 3600
    done
}

[ -n "$SYSTEM_ROOT" ] || console_fallback
[ -f "$SYSTEM_ROOT/composition/web/index.html" ] || console_fallback
[ -x /usr/bin/cage ] || console_fallback
[ -x /usr/bin/cog ] || console_fallback
[ -x /usr/bin/seatd-launch ] || console_fallback
[ -x /bin/busybox ] || console_fallback
[ -e /dev/dri/card0 ] || console_fallback

mkdir -p "$RUNTIME_DIR"
chmod 700 "$RUNTIME_DIR"
: > "$HTTP_LOG"
: > "$HOST_LOG"

export XDG_RUNTIME_DIR="$RUNTIME_DIR"
export HOME=/root
export ORDAX_SURFACE_MODE=native-graphical

# Serve the checked-out shared system tree locally so ES modules, CSS and the
# platform-neutral Surface host load with normal browser origin semantics.
/bin/busybox httpd -f -p 127.0.0.1:8765 -h "$SYSTEM_ROOT" >"$HTTP_LOG" 2>&1 &
HTTP_PID=$!
sleep 1
kill -0 "$HTTP_PID" >/dev/null 2>&1 || console_fallback

printf '\033[2J\033[H'
printf 'OrdaX: iniciando Surface grafica...\n'

# seatd-launch owns the seat for this one kiosk session. Cage talks directly to
# DRM/KMS and input devices; Cog/WPE WebKit renders the same shared Surface used
# by the Web composition. No target-specific visual fork is introduced here.
if /usr/bin/seatd-launch -- /usr/bin/cage -s -- \
    /usr/bin/cog --platform=wl \
    --enable-write-console-messages-to-stdout=true \
    http://127.0.0.1:8765/composition/web/index.html \
    >"$HOST_LOG" 2>&1; then
    exit 0
fi

console_fallback

#!/bin/sh
set -eu

printf '\033[2J\033[H'
printf 'OrdaX\n'
printf 'Surface bootstrap candidate\n'
printf 'Release root: %s\n' "${ORDAX_SYSTEM_ROOT:-unknown}"
printf 'Mode: %s\n' "${ORDAX_SURFACE_MODE:-unknown}"
printf '\nThe graphical Surface is not loaded in this bootstrap milestone.\n'
printf 'This runtime exists to prove verified release -> system -> Surface handoff.\n'

trap 'exit 0' HUP INT TERM
while :; do
    sleep 3600
done

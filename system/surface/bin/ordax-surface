#!/bin/sh
set -eu

SYSTEM_ROOT=${ORDAX_SYSTEM_ROOT:-}
SOURCE_SHA=unknown
STATE_ROOT=${ORDAX_STATE_DIR:-/state/ordax}
PERSISTENT_NATIVE_STATE=$STATE_ROOT/native-state
PERSISTENT_USER_HOME=$STATE_ROOT/home
RESCUE_SOURCE=$SYSTEM_ROOT/rescue/agent.sh
RESCUE_DIR=$STATE_ROOT/rescue
RESCUE_AGENT=$RESCUE_DIR/agent.sh
RESCUE_LOG=$RESCUE_DIR/launcher.log
RESCUE_PID_FILE=$RESCUE_DIR/agent.pid
BASE_TELEMETRY_SOURCE=$SYSTEM_ROOT/services/telemetry/base-agent.sh
BASE_TELEMETRY_CONFIG_SOURCE=$SYSTEM_ROOT/services/telemetry/relay.json
BASE_TELEMETRY_DIR=$STATE_ROOT/telemetry
BASE_TELEMETRY_AGENT=$BASE_TELEMETRY_DIR/agent.sh
BASE_TELEMETRY_CONFIG=$BASE_TELEMETRY_DIR/relay.json
BASE_TELEMETRY_LOG=$BASE_TELEMETRY_DIR/launcher.log
BASE_TELEMETRY_PID_FILE=$BASE_TELEMETRY_DIR/agent.pid
SESSION_DIR=/run/ordax-surface
HTTP_LOG=$SESSION_DIR/http.log
HOST_LOG=$SESSION_DIR/host.log
TIME_SYNC_LOG=$SESSION_DIR/time-sync.log
POWER_REQUEST=$SESSION_DIR/power-request
SEATD_SOCKET=/run/seatd.sock
RUNTIME_STATE=$STATE_ROOT/runtime/native-surface
RUNTIME_ID=alpine-v3.22-cage-barkery-v1
RUNTIME_ROOT=$RUNTIME_STATE/$RUNTIME_ID/rootfs
RUNTIME_READY=$RUNTIME_STATE/$RUNTIME_ID/ready
HTTP_PID=""
GRAPHICS_PID=""
POWER_BROKER_PID=""
TIME_SYNC_PID=""
STAGING_DIR=""
DEV_BOUND=0
PROC_BOUND=0
SYS_BOUND=0
RUN_BOUND=0
SYSTEM_BOUND=0
STATE_BOUND=0
USER_HOME_BOUND=0
UDEV_ACTIVE=0

mkdir -p "$SESSION_DIR" "$PERSISTENT_NATIVE_STATE" "$PERSISTENT_USER_HOME" "$RESCUE_DIR" "$BASE_TELEMETRY_DIR"
chmod 700 "$SESSION_DIR" "$PERSISTENT_NATIVE_STATE" "$PERSISTENT_USER_HOME" "$RESCUE_DIR" "$BASE_TELEMETRY_DIR"
: > "$HTTP_LOG"
: > "$HOST_LOG"
: > "$TIME_SYNC_LOG"

persistent_agent_pid_matches() {
    pid=${1:-}
    expected_path=${2:-}
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$pid" -gt 1 ] 2>/dev/null || return 1
    [ -n "$expected_path" ] || return 1
    kill -0 "$pid" >/dev/null 2>&1 || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    command_line=$(/bin/busybox tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$command_line" in
        *"$expected_path"*) return 0 ;;
    esac
    return 1
}

base_telemetry_agent_running() {
    pid=""
    [ -s "$BASE_TELEMETRY_PID_FILE" ] && IFS= read -r pid <"$BASE_TELEMETRY_PID_FILE" || true
    persistent_agent_pid_matches "$pid" "$BASE_TELEMETRY_AGENT"
}

ensure_base_telemetry_agent() {
    [ -f "$BASE_TELEMETRY_SOURCE" ] || {
        echo "ordax-surface: base telemetry source unavailable: $BASE_TELEMETRY_SOURCE" >>"$BASE_TELEMETRY_LOG"
        return 0
    }
    [ -f "$BASE_TELEMETRY_CONFIG_SOURCE" ] || {
        echo "ordax-surface: base telemetry config unavailable: $BASE_TELEMETRY_CONFIG_SOURCE" >>"$BASE_TELEMETRY_LOG"
        return 0
    }

    base_agent_changed=1
    if [ -f "$BASE_TELEMETRY_AGENT" ] && /bin/busybox cmp "$BASE_TELEMETRY_SOURCE" "$BASE_TELEMETRY_AGENT" >/dev/null 2>&1; then
        base_agent_changed=0
    fi

    temporary=$BASE_TELEMETRY_AGENT.tmp.$$
    cp "$BASE_TELEMETRY_SOURCE" "$temporary" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1
    chmod 700 "$temporary" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1
    /bin/busybox mv -f "$temporary" "$BASE_TELEMETRY_AGENT" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1

    temporary=$BASE_TELEMETRY_CONFIG.tmp
    cp "$BASE_TELEMETRY_CONFIG_SOURCE" "$temporary" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1
    chmod 600 "$temporary" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1
    /bin/busybox mv -f "$temporary" "$BASE_TELEMETRY_CONFIG" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1

    if [ "$base_agent_changed" -eq 1 ] && base_telemetry_agent_running; then
        pid=""
        IFS= read -r pid <"$BASE_TELEMETRY_PID_FILE" || true
        terminate_child "$pid" "base telemetry agent"
        rm -f "$BASE_TELEMETRY_PID_FILE"
        echo "ordax-surface: refreshed persistent base telemetry agent" >>"$BASE_TELEMETRY_LOG"
    fi

    base_telemetry_agent_running && return 0

    if [ -x /bin/setsid ]; then
        /bin/setsid "$BASE_TELEMETRY_AGENT" >>"$BASE_TELEMETRY_LOG" 2>&1 </dev/null &
    else
        "$BASE_TELEMETRY_AGENT" >>"$BASE_TELEMETRY_LOG" 2>&1 </dev/null &
    fi
    /bin/busybox sleep 1
    base_telemetry_agent_running || {
        echo "ordax-surface: base telemetry agent did not remain running" >>"$BASE_TELEMETRY_LOG"
        return 1
    }
    echo "ordax-surface: persistent base telemetry agent is running" >>"$BASE_TELEMETRY_LOG"
    return 0
}

rescue_agent_running() {
    pid=""
    [ -s "$RESCUE_PID_FILE" ] && IFS= read -r pid <"$RESCUE_PID_FILE" || true
    persistent_agent_pid_matches "$pid" "$RESCUE_AGENT"
}

ensure_rescue_agent() {
    [ -f "$RESCUE_SOURCE" ] || {
        echo "ordax-surface: rescue agent source unavailable: $RESCUE_SOURCE" >>"$RESCUE_LOG"
        return 0
    }

    rescue_agent_changed=1
    if [ -f "$RESCUE_AGENT" ] && /bin/busybox cmp "$RESCUE_SOURCE" "$RESCUE_AGENT" >/dev/null 2>&1; then
        rescue_agent_changed=0
    fi

    temporary=$RESCUE_AGENT.tmp.$$
    cp "$RESCUE_SOURCE" "$temporary" >>"$RESCUE_LOG" 2>&1 || return 1
    chmod 700 "$temporary" >>"$RESCUE_LOG" 2>&1 || return 1
    /bin/busybox mv -f "$temporary" "$RESCUE_AGENT" >>"$RESCUE_LOG" 2>&1 || return 1

    if [ "$rescue_agent_changed" -eq 1 ] && rescue_agent_running; then
        pid=""
        IFS= read -r pid <"$RESCUE_PID_FILE" || true
        terminate_child "$pid" "rescue agent"
        rm -f "$RESCUE_PID_FILE"
        echo "ordax-surface: refreshed persistent rescue agent" >>"$RESCUE_LOG"
    fi

    rescue_agent_running && return 0

    if [ -x /bin/setsid ]; then
        /bin/setsid "$RESCUE_AGENT" >>"$RESCUE_LOG" 2>&1 </dev/null &
    else
        "$RESCUE_AGENT" >>"$RESCUE_LOG" 2>&1 </dev/null &
    fi
    /bin/busybox sleep 1
    rescue_agent_running || {
        echo "ordax-surface: rescue agent did not remain running" >>"$RESCUE_LOG"
        return 1
    }
    echo "ordax-surface: persistent rescue agent is running" >>"$RESCUE_LOG"
    return 0
}

terminate_child() {
    pid=${1:-}
    label=${2:-child}
    case "$pid" in
        ''|*[!0-9]*) return 0 ;;
    esac
    [ "$pid" -gt 1 ] 2>/dev/null || return 0
    kill -0 "$pid" >/dev/null 2>&1 || return 0

    kill "$pid" >/dev/null 2>&1 || true
    remaining=2
    while kill -0 "$pid" >/dev/null 2>&1 && [ "$remaining" -gt 0 ]; do
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    if kill -0 "$pid" >/dev/null 2>&1; then
        echo "ordax-surface: forcing stale $label pid $pid" >>"$HOST_LOG"
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    wait "$pid" 2>/dev/null || true
}

runtime_root_processes() {
    [ -d "$RUNTIME_ROOT" ] || return 0
    for root_link in /proc/[0-9]*/root; do
        [ -L "$root_link" ] || continue
        pid=${root_link#/proc/}
        pid=${pid%/root}
        root_target=$(/bin/busybox readlink "$root_link" 2>/dev/null || true)
        [ "$root_target" = "$RUNTIME_ROOT" ] || continue
        printf '%s\n' "$pid"
    done
}

reap_stale_runtime_processes() {
    stale_pids=$(runtime_root_processes || true)
    [ -n "$stale_pids" ] || return 0

    echo "ordax-surface: reaping stale processes rooted in graphical runtime" >>"$HOST_LOG"
    for pid in $stale_pids; do
        case "$pid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$pid" -gt 1 ] 2>/dev/null || continue
        kill "$pid" >/dev/null 2>&1 || true
    done

    /bin/busybox sleep 1

    for pid in $stale_pids; do
        case "$pid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$pid" -gt 1 ] 2>/dev/null || continue
        if kill -0 "$pid" >/dev/null 2>&1; then
            echo "ordax-surface: forcing stale runtime pid $pid" >>"$HOST_LOG"
            kill -KILL "$pid" >/dev/null 2>&1 || true
        fi
    done
}

clear_stale_runtime_mounts() {
    [ -d "$RUNTIME_ROOT" ] || return 0
    for target in \
        "$RUNTIME_ROOT/var/lib/ordax-user" \
        "$RUNTIME_ROOT/var/lib/ordax" \
        "$RUNTIME_ROOT/srv/ordax-system" \
        "$RUNTIME_ROOT/run" \
        "$RUNTIME_ROOT/sys" \
        "$RUNTIME_ROOT/proc" \
        "$RUNTIME_ROOT/dev"
    do
        /bin/busybox umount "$target" >/dev/null 2>&1 || true
    done
}

seatd_process_running() {
    for comm in /proc/[0-9]*/comm; do
        [ -r "$comm" ] || continue
        process_name=""
        IFS= read -r process_name <"$comm" || true
        [ "$process_name" = "seatd" ] && return 0
    done
    return 1
}

remove_stale_seatd_socket() {
    [ -e "$SEATD_SOCKET" ] || return 0
    if [ ! -S "$SEATD_SOCKET" ]; then
        echo "ordax-surface: seatd path exists but is not a UNIX socket: $SEATD_SOCKET" >>"$HOST_LOG"
        return 1
    fi
    if seatd_process_running; then
        echo "ordax-surface: seatd socket is owned by a running seatd process; refusing to remove it" >>"$HOST_LOG"
        return 1
    fi
    echo "ordax-surface: removing stale seatd socket $SEATD_SOCKET" >>"$HOST_LOG"
    rm -f "$SEATD_SOCKET" >>"$HOST_LOG" 2>&1 || return 1
    return 0
}

cleanup() {
    if [ -n "$TIME_SYNC_PID" ]; then
        terminate_child "$TIME_SYNC_PID" "time sync agent"
        TIME_SYNC_PID=""
    fi
    if [ -n "$POWER_BROKER_PID" ]; then
        terminate_child "$POWER_BROKER_PID" "power broker"
        POWER_BROKER_PID=""
    fi
    rm -f "$POWER_REQUEST" >/dev/null 2>&1 || true
    if [ -n "$GRAPHICS_PID" ]; then
        terminate_child "$GRAPHICS_PID" "graphics host"
        GRAPHICS_PID=""
    fi
    if [ -n "$HTTP_PID" ]; then
        terminate_child "$HTTP_PID" "native HTTP host"
        HTTP_PID=""
    fi
    reap_stale_runtime_processes
    if [ "$UDEV_ACTIVE" -eq 1 ] && [ -x "$RUNTIME_ROOT/bin/udevadm" ]; then
        /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm control --exit >/dev/null 2>&1 || true
        UDEV_ACTIVE=0
    fi
    if [ -S "$SEATD_SOCKET" ] && ! seatd_process_running; then
        rm -f "$SEATD_SOCKET" >/dev/null 2>&1 || true
    fi
    if [ "$SYSTEM_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/srv/ordax-system" >/dev/null 2>&1 || true
        SYSTEM_BOUND=0
    fi
    if [ "$USER_HOME_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/var/lib/ordax-user" >/dev/null 2>&1 || true
        USER_HOME_BOUND=0
    fi
    if [ "$STATE_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/var/lib/ordax" >/dev/null 2>&1 || true
        STATE_BOUND=0
    fi
    if [ "$RUN_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/run" >/dev/null 2>&1 || true
        RUN_BOUND=0
    fi
    if [ "$SYS_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/sys" >/dev/null 2>&1 || true
        SYS_BOUND=0
    fi
    if [ "$PROC_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/proc" >/dev/null 2>&1 || true
        PROC_BOUND=0
    fi
    if [ "$DEV_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/dev" >/dev/null 2>&1 || true
        DEV_BOUND=0
    fi
    if [ -n "$STAGING_DIR" ] && [ -d "$STAGING_DIR" ]; then
        rm -rf "$STAGING_DIR"
        STAGING_DIR=""
    fi
}

terminate() {
    trap - EXIT HUP INT TERM
    cleanup
    exit 0
}

trap cleanup EXIT
trap terminate HUP INT TERM

console_fallback() {
    cleanup
    printf '\033[2J\033[H'
    printf 'OrdaX\n'
    printf 'Surface native host fallback\n'
    printf 'Release root: %s\n' "${SYSTEM_ROOT:-unknown}"
    printf 'Mode: %s\n' "${ORDAX_SURFACE_MODE:-unknown}"
    printf '\nThe graphical host could not be started.\n'
    printf 'Host log: %s\n' "$HOST_LOG"
    printf 'HTTP log: %s\n' "$HTTP_LOG"
    if [ -s "$HOST_LOG" ]; then
        printf '\nDiagnostic:\n'
        /bin/busybox tail -n 28 "$HOST_LOG" 2>/dev/null || cat "$HOST_LOG" 2>/dev/null || true
    fi
    if [ -s "$HTTP_LOG" ]; then
        printf '\nHTTP diagnostic:\n'
        /bin/busybox tail -n 20 "$HTTP_LOG" 2>/dev/null || cat "$HTTP_LOG" 2>/dev/null || true
    fi
    printf '\nThe checked-out system remains available for maintenance.\n'
    trap 'exit 0' HUP INT TERM
    while :; do sleep 3600; done
}

fallback_with_reason() {
    printf 'ordax-surface: %s\n' "$*" >>"$HOST_LOG"
    console_fallback
}

runtime_base_is_ready() {
    [ -f "$RUNTIME_READY" ] &&
        [ -x "$RUNTIME_ROOT/usr/bin/cage" ] &&
        [ -x "$RUNTIME_ROOT/usr/bin/barkery" ] &&
        [ -x "$RUNTIME_ROOT/usr/bin/python3" ] &&
        [ -x "$RUNTIME_ROOT/usr/bin/seatd-launch" ] &&
        [ -x "$RUNTIME_ROOT/bin/busybox" ]
}

runtime_is_ready() {
    runtime_base_is_ready &&
        [ -x "$RUNTIME_ROOT/usr/bin/Xwayland" ] &&
        [ -x "$RUNTIME_ROOT/sbin/udevd" ] &&
        [ -x "$RUNTIME_ROOT/bin/udevadm" ] &&
        [ -f "$RUNTIME_ROOT/usr/lib/udev/rules.d/60-input-id.rules" ]
}

install_runtime() {
    [ -x /sbin/apk ] || { echo "ordax-surface: /sbin/apk is unavailable in the Git bootstrap base" >>"$HOST_LOG"; return 1; }
    [ -d /etc/apk/keys ] || { echo "ordax-surface: Alpine trusted keys are unavailable" >>"$HOST_LOG"; return 1; }
    set -- /etc/apk/keys/*.pub
    [ -f "$1" ] || { echo "ordax-surface: Alpine trusted public keys are unavailable" >>"$HOST_LOG"; return 1; }

    mkdir -p "$RUNTIME_STATE"
    STAGING_DIR=$RUNTIME_STATE/.staging-$$
    rm -rf "$STAGING_DIR"
    mkdir -p "$STAGING_DIR/rootfs/etc/apk/keys"
    for key in /etc/apk/keys/*.pub; do cp "$key" "$STAGING_DIR/rootfs/etc/apk/keys/"; done
    if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
        mkdir -p "$STAGING_DIR/rootfs/etc/ssl/certs"
        cp /etc/ssl/certs/ca-certificates.crt "$STAGING_DIR/rootfs/etc/ssl/certs/"
    fi
    cat >"$STAGING_DIR/rootfs/etc/apk/repositories" <<'REPOSITORIES'
https://dl-cdn.alpinelinux.org/alpine/v3.22/main
https://dl-cdn.alpinelinux.org/alpine/v3.22/community
REPOSITORIES

    echo "ordax-surface: provisioning replaceable graphical runtime in $RUNTIME_STATE" >>"$HOST_LOG"
    if ! /sbin/apk --root "$STAGING_DIR/rootfs" --keys-dir /etc/apk/keys --no-cache --initdb add \
        alpine-baselayout busybox ca-certificates cage barkery-browser xwayland \
        seatd-launch mesa-dri-gallium mesa-egl mesa-gbm font-dejavu \
        eudev libinput-udev >>"$HOST_LOG" 2>&1; then
        echo "ordax-surface: graphical runtime provisioning failed" >>"$HOST_LOG"
        return 1
    fi

    for directory in dev proc sys run tmp root srv/ordax-system var/lib/ordax var/lib/ordax-user; do mkdir -p "$STAGING_DIR/rootfs/$directory"; done
    chmod 1777 "$STAGING_DIR/rootfs/tmp" 2>/dev/null || true
    [ -x "$STAGING_DIR/rootfs/usr/bin/cage" ] || return 1
    [ -x "$STAGING_DIR/rootfs/usr/bin/barkery" ] || return 1
    [ -x "$STAGING_DIR/rootfs/usr/bin/python3" ] || return 1
    [ -x "$STAGING_DIR/rootfs/usr/bin/Xwayland" ] || return 1
    [ -x "$STAGING_DIR/rootfs/sbin/udevd" ] || return 1
    [ -x "$STAGING_DIR/rootfs/bin/udevadm" ] || return 1
    [ -x "$STAGING_DIR/rootfs/usr/bin/seatd-launch" ] || return 1

    printf '%s\n' "$RUNTIME_ID" >"$STAGING_DIR/ready"
    rm -rf "$RUNTIME_STATE/$RUNTIME_ID"
    mv "$STAGING_DIR" "$RUNTIME_STATE/$RUNTIME_ID"
    STAGING_DIR=""
}

upgrade_existing_runtime() {
    echo "ordax-surface: extending existing graphical runtime with input discovery support" >>"$HOST_LOG"
    if ! /sbin/apk --root "$RUNTIME_ROOT" --keys-dir /etc/apk/keys --no-cache add \
        xwayland eudev libinput-udev >>"$HOST_LOG" 2>&1; then
        echo "ordax-surface: failed to extend existing graphical runtime" >>"$HOST_LOG"
        return 1
    fi
    runtime_is_ready
}

ensure_runtime() {
    runtime_is_ready && return 0
    if runtime_base_is_ready; then
        upgrade_existing_runtime || return 1
        return 0
    fi
    install_runtime || return 1
    runtime_is_ready
}

ensure_loopback() {
    [ -x /sbin/ip ] || { echo "ordax-surface: /sbin/ip is unavailable; cannot configure loopback" >>"$HOST_LOG"; return 1; }
    /sbin/ip link set dev lo up >>"$HOST_LOG" 2>&1 || return 1
    /sbin/ip address replace 127.0.0.1/8 dev lo >>"$HOST_LOG" 2>&1 || return 1
}

ensure_shared_memory() {
    mkdir -p /dev/shm >>"$HOST_LOG" 2>&1 || return 1
    chmod 1777 /dev/shm >>"$HOST_LOG" 2>&1 || return 1
}

configure_browser() {
    repo_root=${SYSTEM_ROOT%/system}
    if [ "$repo_root" != "$SYSTEM_ROOT" ] && [ -x /usr/bin/git ]; then
        candidate_sha=$(/usr/bin/git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf 'unknown')
        case "$candidate_sha" in
            [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*)
                SOURCE_SHA=$candidate_sha
                ;;
            *)
                SOURCE_SHA=unknown
                ;;
        esac
    fi
    mkdir -p "$RUNTIME_ROOT/etc/barkery" || return 1
    cat >"$RUNTIME_ROOT/etc/barkery/barkery.conf" <<BARKERY
[browser]
start_uri = http://127.0.0.1:8765/composition/native/index.html?source=$SOURCE_SHA
preferred_languages = pt-BR,en-US

[mqtt]
enabled = 0
BARKERY
    mkdir -p "$RUNTIME_ROOT/tmp/ordax-web-cache-$SOURCE_SHA" || return 1
}

bind_runtime_mounts() {
    mkdir -p \
        "$RUNTIME_ROOT/srv/ordax-system" \
        "$RUNTIME_ROOT/var/lib/ordax" \
        "$RUNTIME_ROOT/var/lib/ordax-user" \
        "$PERSISTENT_NATIVE_STATE" \
        "$PERSISTENT_USER_HOME" || return 1
    chmod 700 "$PERSISTENT_NATIVE_STATE" "$PERSISTENT_USER_HOME" || return 1
    /bin/busybox mount -o bind "$SYSTEM_ROOT" "$RUNTIME_ROOT/srv/ordax-system" >>"$HOST_LOG" 2>&1 || return 1
    SYSTEM_BOUND=1
    /bin/busybox mount -o bind "$PERSISTENT_NATIVE_STATE" "$RUNTIME_ROOT/var/lib/ordax" >>"$HOST_LOG" 2>&1 || return 1
    STATE_BOUND=1
    /bin/busybox mount -o bind "$PERSISTENT_USER_HOME" "$RUNTIME_ROOT/var/lib/ordax-user" >>"$HOST_LOG" 2>&1 || return 1
    USER_HOME_BOUND=1
    /bin/busybox mount -o bind /dev "$RUNTIME_ROOT/dev" >>"$HOST_LOG" 2>&1 || return 1
    DEV_BOUND=1
    /bin/busybox mount -o bind /proc "$RUNTIME_ROOT/proc" >>"$HOST_LOG" 2>&1 || return 1
    PROC_BOUND=1
    /bin/busybox mount -o bind /sys "$RUNTIME_ROOT/sys" >>"$HOST_LOG" 2>&1 || return 1
    SYS_BOUND=1
    /bin/busybox mount -o bind /run "$RUNTIME_ROOT/run" >>"$HOST_LOG" 2>&1 || return 1
    RUN_BOUND=1
}

start_time_sync_agent() {
    (
        retry_delay=120
        steady_delay=1800
        while :; do
            synced=0
            for server in time.cloudflare.com time.google.com pool.ntp.org; do
                if /bin/busybox timeout -k 1 6 /bin/busybox ntpd -q -n -p "$server" >>"$TIME_SYNC_LOG" 2>&1; then
                    synced=1
                    break
                fi
            done
            if [ "$synced" -eq 1 ]; then
                /bin/busybox sleep "$steady_delay"
            else
                /bin/busybox sleep "$retry_delay"
            fi
        done
    ) &
    TIME_SYNC_PID=$!
    kill -0 "$TIME_SYNC_PID" >/dev/null 2>&1
}

prepare_power_broker() {
    rm -f "$POWER_REQUEST" >/dev/null 2>&1 || true
    /bin/busybox mkfifo "$POWER_REQUEST" >>"$HOST_LOG" 2>&1 || return 1
    chmod 600 "$POWER_REQUEST" >>"$HOST_LOG" 2>&1 || return 1

    (
        exec 9<>"$POWER_REQUEST" || exit 1
        while :; do
            action=""
            if IFS= read -r action <&9; then
                case "$action" in
                    restart)
                        echo "ordax-surface: host power broker accepted restart" >>"$HOST_LOG"
                        /bin/busybox sleep 1
                        if ! /bin/busybox reboot -f >>"$HOST_LOG" 2>&1; then
                            echo "ordax-surface: host reboot command returned without rebooting" >>"$HOST_LOG"
                        fi
                        ;;
                    shutdown)
                        echo "ordax-surface: host power broker accepted shutdown" >>"$HOST_LOG"
                        /bin/busybox sleep 1
                        if ! /bin/busybox poweroff -f >>"$HOST_LOG" 2>&1; then
                            echo "ordax-surface: host poweroff command returned without shutting down" >>"$HOST_LOG"
                        fi
                        ;;
                    *)
                        [ -n "$action" ] && echo "ordax-surface: rejected unknown host power request: $action" >>"$HOST_LOG"
                        ;;
                esac
            else
                /bin/busybox sleep 1
            fi
        done
    ) &
    POWER_BROKER_PID=$!
    kill -0 "$POWER_BROKER_PID" >/dev/null 2>&1 || return 1
}

wait_for_native_server() {
    remaining=${1:-10}
    while [ "$remaining" -gt 0 ]; do
        [ -n "$HTTP_PID" ] && kill -0 "$HTTP_PID" >/dev/null 2>&1 || return 1
        if /bin/busybox chroot "$RUNTIME_ROOT" /usr/bin/python3 -c 'import socket; s=socket.create_connection(("127.0.0.1", 8765), 0.5); s.close()' >>"$HTTP_LOG" 2>&1; then
            return 0
        fi
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    return 1
}

prepare_input_stack() {
    set -- /dev/input/event*
    if [ ! -e "$1" ]; then
        echo "ordax-surface: no /dev/input/event* devices are visible on the host" >>"$HOST_LOG"
        [ -d /dev/input ] && ls -la /dev/input >>"$HOST_LOG" 2>&1 || true
        return 1
    fi
    echo "ordax-surface: input event devices are present; starting eudev classification" >>"$HOST_LOG"
    mkdir -p "$RUNTIME_ROOT/run/udev" || return 1
    /bin/busybox chroot "$RUNTIME_ROOT" /sbin/udevd --daemon >>"$HOST_LOG" 2>&1 || return 1
    UDEV_ACTIVE=1
    /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm control --reload-rules >>"$HOST_LOG" 2>&1 || return 1
    /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm trigger --subsystem-match=input --action=add >>"$HOST_LOG" 2>&1 || return 1
    /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm settle --timeout=5 >>"$HOST_LOG" 2>&1 || return 1
    /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm info --query=property --name="$1" >>"$HOST_LOG" 2>&1 || true
    echo "ordax-surface: eudev input classification complete" >>"$HOST_LOG"
}

[ -n "$SYSTEM_ROOT" ] || fallback_with_reason "ORDAX_SYSTEM_ROOT is empty"
ensure_base_telemetry_agent || echo "ordax-surface: base telemetry bootstrap failed; continuing Surface startup" >>"$HOST_LOG"
ensure_rescue_agent || echo "ordax-surface: rescue agent bootstrap failed; continuing Surface startup" >>"$HOST_LOG"
start_time_sync_agent || echo "ordax-surface: automatic time synchronization unavailable; continuing Surface startup" >>"$HOST_LOG"
[ -f "$SYSTEM_ROOT/composition/native/index.html" ] || fallback_with_reason "native Surface composition is missing: $SYSTEM_ROOT/composition/native/index.html"
[ -f "$SYSTEM_ROOT/surface/runtime/native_host_server.py" ] || fallback_with_reason "native Surface host server is missing: $SYSTEM_ROOT/surface/runtime/native_host_server.py"
[ -x /bin/busybox ] || fallback_with_reason "/bin/busybox is unavailable in the bootstrap base"
[ -e /dev/dri/card0 ] || fallback_with_reason "DRM device /dev/dri/card0 is unavailable"
reap_stale_runtime_processes
clear_stale_runtime_mounts
ensure_runtime || fallback_with_reason "graphical runtime is unavailable after provisioning attempt"
ensure_loopback || fallback_with_reason "failed to configure IPv4 loopback for local Surface HTTP"
ensure_shared_memory || fallback_with_reason "failed to prepare /dev/shm for wlroots/Xwayland"
configure_browser || fallback_with_reason "failed to configure Barkery browser runtime"
bind_runtime_mounts || fallback_with_reason "failed to bind host resources into graphical runtime"
prepare_input_stack || fallback_with_reason "failed to prepare physical keyboard/touchpad input devices"
remove_stale_seatd_socket || fallback_with_reason "failed to clear stale seatd socket before native host startup"
prepare_power_broker || fallback_with_reason "failed to prepare host power broker"

export XDG_RUNTIME_DIR="$SESSION_DIR"
export HOME=/root
export GDK_BACKEND=wayland
export XDG_CACHE_HOME=/tmp/ordax-web-cache-$SOURCE_SHA
export ORDAX_SURFACE_MODE=native-graphical

/bin/busybox chroot "$RUNTIME_ROOT" \
    /usr/bin/python3 /srv/ordax-system/surface/runtime/native_host_server.py \
    --bind 127.0.0.1 --port 8765 --directory /srv/ordax-system \
    --user-root /var/lib/ordax-user --power-request /run/ordax-surface/power-request \
    --telemetry-config /srv/ordax-system/services/telemetry/relay.json \
    >"$HTTP_LOG" 2>&1 &
HTTP_PID=$!
wait_for_native_server 10 || fallback_with_reason "native Surface HTTP/control server failed readiness check"

printf '\033[2J\033[H'
printf 'OrdaX: iniciando Surface grafica...\n'

/bin/busybox chroot "$RUNTIME_ROOT" \
    /usr/bin/seatd-launch -- /usr/bin/cage -s -- /usr/bin/barkery \
    >"$HOST_LOG" 2>&1 &
GRAPHICS_PID=$!
host_rc=0
while kill -0 "$GRAPHICS_PID" >/dev/null 2>&1; do
    if ! kill -0 "$HTTP_PID" >/dev/null 2>&1; then
        echo "ordax-surface: native HTTP/control server exited while graphics remained active" >>"$HOST_LOG"
        terminate_child "$GRAPHICS_PID" "graphics host"
        GRAPHICS_PID=""
        exit 1
    fi
    /bin/busybox sleep 1
done
wait "$GRAPHICS_PID" 2>/dev/null || host_rc=$?
GRAPHICS_PID=""

[ "$host_rc" -eq 0 ] && exit 0

fallback_with_reason "native Cage/Barkery host exited with status $host_rc"
